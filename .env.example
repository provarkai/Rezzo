# Copy to .env and fill in values for your environment.

# SQLite database file used by Prisma (dev). Point this at a writable path.
DATABASE_URL="file:./db/custom.db"

# Secret used to sign auth tokens (HMAC-SHA256). Set a strong random value in production.
REZZO_TOKEN_SECRET="change-me-to-a-long-random-secret"

# Paystack secret key. When set, payments go through real Paystack checkout
# (customer redirected to authorization_url; confirmation happens via the
# webhook below) instead of the MOCK self-confirm flow used for demos.
# Get a test key from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=""

# Optional. Used to build Paystack's callback_url (where it redirects the
# customer's browser after checkout). If unset, Paystack falls back to the
# URL configured on the dashboard — confirmation still works either way,
# since that always comes from the webhook, not the redirect.
APP_URL=""
