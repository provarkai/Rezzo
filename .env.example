# Copy to .env and fill in values for your environment.

# Postgres, via Neon (neon.tech — free tier, no card required). Create a
# project, then copy both connection strings it gives you from the
# dashboard's "Connection Details" panel:
#   - DATABASE_URL: the *pooled* connection string (hostname has "-pooler"
#     in it). This is what the app uses at runtime — required when
#     deploying to Vercel, since serverless functions can open many
#     concurrent connections that a direct connection can't handle.
#   - DIRECT_URL: the *direct* (unpooled) connection string. Only used by
#     `prisma migrate`/`prisma db push` to run schema changes.
# Local dev without Neon: run Postgres in a container instead —
# `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16` —
# and set both vars to the same local URL.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/rezzo?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/rezzo?sslmode=require"

# Secret used to sign auth tokens (HMAC-SHA256). Set a strong random value in production.
REZZO_TOKEN_SECRET="change-me-to-a-long-random-secret"

# Claude API key — powers AI REZZO's case-intake classification
# (ai-orchestrator.ts: intent/category/risk extraction from what the
# customer typed). Get one at https://console.anthropic.com/settings/keys.
# Optional: unset, orchestration silently falls back to the built-in
# keyword-matching classifier (mockAiOrchestration) rather than failing
# case intake — it just won't be as accurate.
ANTHROPIC_API_KEY=""

# Paystack secret key. When set, payments go through real Paystack checkout
# (customer redirected to authorization_url; confirmation happens via the
# webhook below) instead of the MOCK self-confirm flow used for demos.
# Get a test key from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=""

# Optional. Used to build Paystack's callback_url (where it redirects the
# customer's browser after checkout). If unset, Paystack falls back to the
# URL configured on the dashboard — confirmation still works either way,
# since that always comes from the webhook, not the redirect.
APP_URL=""

# WhatsApp (Meta Cloud API). All four required for the adapter to do
# anything — without them the webhook route exists but can't verify or
# reply. Get these from a Meta developer app with the WhatsApp product
# added: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Any string you choose — set the same value on the Meta app's webhook
# subscription page.
WHATSAPP_VERIFY_TOKEN=""
# The app secret (not the access token) — used to verify each inbound
# webhook's signature.
WHATSAPP_APP_SECRET=""

# Optional. Every trackEvent() call always logs structurally to stdout —
# set this to also forward events to a PostHog project. POSTHOG_HOST only
# matters for a self-hosted PostHog instance; the default is PostHog Cloud.
POSTHOG_API_KEY=""
POSTHOG_HOST=""
